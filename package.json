{
  "name": "rabtx-web",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "@tailwindcss/postcss": "^4.3.3",
      "@tailwindcss/turbopack": "^4.3.3",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vercel/analytics": "^2.0.1",
      "eslint": "^10.14.0",
      "eslint-config-next": "16.4.4",
      "gray-matter": "^4.0.3",
      "lucide-react": "^1.66.0",
      "next": "16.4.4",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-markdown": "^10.1.0",
      "remark-gfm": "^4.0.1",
      "tailwindcss": "^4.3.3",
      "typescript": "^6.0.3"
    }
  },
  "scripts": {
    "dev:landing": "bun --filter landing dev",
    "dev:portfolio": "bun --filter portfolio dev",
    "build": "bun --filter '*' build",
    "lint": "bun --filter '*' lint",
    "typecheck": "bun --filter '*' typecheck"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "ignoreScripts": ["sharp", "unrs-resolver"],
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
